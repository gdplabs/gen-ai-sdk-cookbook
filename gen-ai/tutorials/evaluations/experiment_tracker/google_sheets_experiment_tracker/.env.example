# OpenRouter API key for the evaluation judge
OPENROUTER_API_KEY=

# Google Sheets service account credentials
GOOGLE_SHEETS_CLIENT_EMAIL=
# Base64-encode the complete private_key PEM, including its line breaks.
GOOGLE_SHEETS_PRIVATE_KEY=

# Set one target. An existing spreadsheet ID takes priority over the folder ID.
GOOGLE_SHEETS_SPREADSHEET_ID=
MASTER_DRIVE_FOLDER_ID=
