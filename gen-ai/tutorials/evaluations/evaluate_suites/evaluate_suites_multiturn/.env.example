# The default judge is routed through Vertex AI with a service account.
# Path to the service-account JSON used for Vertex
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Vertex region, or "global"
GOOGLE_CLOUD_LOCATION=global
# Billing label attached to every Vertex call, as a JSON object
GOOGLE_VERTEX_LABEL={"billing-owner":"your-team"}
