# OpenRouter API Key for the DeepSeek judge model (evaluator)
# Get your API key from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Sheets API credentials (service account)
GOOGLE_SHEETS_SHEET_ID=your_sheet_id
GOOGLE_SHEETS_CLIENT_EMAIL=your_service_account_email
# The private key must be Base64-encoded. See "Set Up Environment Variables" in README.md.
GOOGLE_SHEETS_PRIVATE_KEY=your_base64_encoded_service_account_private_key
