[
  {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "main",
      "catalogId": "https://github.com/GDP-ADMIN/glchat-sdk/blob/main/js/glchat-a2ui-react-renderer/json/v1_0/glchat_standard_catalog_definition.json",
      "dataModel": {
        "form": {
          "name": "",
          "plan": ["free"],
          "tags": ["a2ui"]
        },
        "session": {
          "expiresAt": "2026-12-31T23:59:59.000Z"
        }
      },
      "components": [
        {
          "id": "root",
          "component": "Card",
          "child": "content"
        },
        {
          "id": "content",
          "component": "Column",
          "children": ["title", "nameField", "plan", "tags", "audio", "expires", "actions"]
        },
        {
          "id": "title",
          "component": "Text",
          "text": "### GLChat v1.0 sample"
        },
        {
          "id": "nameField",
          "component": "TextField",
          "label": "Name",
          "value": {
            "@path": "/form/name"
          },
          "checks": [
            {
              "condition": {
                "@call": "required",
                "args": {
                  "value": {
                    "@path": "/form/name"
                  }
                }
              },
              "message": "Please enter a name."
            }
          ]
        },
        {
          "id": "plan",
          "component": "ChoicePicker",
          "label": "Plan",
          "variant": "mutuallyExclusive",
          "displayStyle": "chips",
          "options": [
            {
              "value": "free",
              "label": "Free"
            },
            {
              "value": "pro",
              "label": "Pro"
            }
          ],
          "value": {
            "@path": "/form/plan"
          }
        },
        {
          "id": "tags",
          "component": "TagInput",
          "label": "Tags",
          "value": {
            "@path": "/form/tags"
          },
          "placeholder": "Add a tag"
        },
        {
          "id": "audio",
          "component": "AudioPlayer",
          "url": "https://www.w3schools.com/html/horse.mp3",
          "description": "Sample audio"
        },
        {
          "id": "expires",
          "component": "Timeout",
          "targetTimeUtc": {
            "@path": "/session/expiresAt"
          }
        },
        {
          "id": "actions",
          "component": "Row",
          "children": ["submit", "delete"]
        },
        {
          "id": "submit",
          "component": "Button",
          "variant": "primary",
          "child": "submitLabel",
          "action": {
            "event": {
              "name": "submit_form",
              "context": {
                "name": {
                  "@path": "/form/name"
                },
                "plan": {
                  "@path": "/form/plan"
                }
              }
            }
          }
        },
        {
          "id": "submitLabel",
          "component": "Text",
          "text": "Submit"
        },
        {
          "id": "delete",
          "component": "Button",
          "variant": "destructive",
          "child": "deleteLabel",
          "action": {
            "event": {
              "name": "delete_item"
            }
          }
        },
        {
          "id": "deleteLabel",
          "component": "Text",
          "text": "Delete"
        }
      ]
    }
  }
]
